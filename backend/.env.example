NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/amade
# Optional comma-separated DNS servers if the system resolver cannot resolve Atlas SRV records.
MONGO_DNS_SERVERS=
# Set true only to opt in to a temporary, non-persistent MongoDB fallback in development.
MONGO_MEMORY_SERVER=false
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
